public int main() {
    int[] a = {1, 2, 3, 4};
    class Acc acc;
    int n;
    acc = new Acc();
    n = length(a);
    putint(acc.sum(a, n));
    putch(10);
    return 0;
}

public class Acc {
    int bias;

    public int sum(int[] a, int n) {
        int i;
        int s;
        i = 0;
        s = this.bias;
        while (i < n) {
            if (a[i] > 0) {
                s = s + a[i];
            } else {
                s = s + 0;
            }
            i = i + 1;
        }
        return s;
    }
}
