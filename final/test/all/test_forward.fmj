public int main() {
    class Child c;
    c = new Child();
    putint(c.getValue());
    putch(10);
    return 0;
}

public class Child extends Parent {
    public int getValue() {
        return this.x + 10;
    }
}

public class Parent {
    int x = 5;
    public int getValue() {
        return this.x;
    }
}
