public int main() {
    int[] arr = {1, 2, 3};
    int x;
    int len;
    class MyClass obj;

    obj = new MyClass();

    len = length(arr);
    x = arr[0];
    arr[1] = 42;

    putint(x);
    putch(10);
    putarray(len, arr);

    x = getint();
    x = getch();

    arr = new int[10];

    while (x > 0) {
        if (x == 5) break;
        if (x == 3) continue;
        x = x - 1;
    }

    x = obj.getValue();
    putint(x);
    putch(10);

    return 0;
}

public class MyClass {
    int val = 100;
    public int getValue() {
        return this.val;
    }
    public int add(int a, int b) {
        return a + b;
    }
}
