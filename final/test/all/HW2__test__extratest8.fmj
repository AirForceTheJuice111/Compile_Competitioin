/* 测试: 继承的类型兼容性 (子类赋给父类变量应该合法) */
public int main() {
    class Parent p;
    class Child c;
    int r;
    c = new Child();
    p = c;
    r = p.getValue();
    return r;
}

public class Parent {
    int val;
    public int getValue() {
        return val;
    }
}

public class Child extends Parent {
    int extra;
}

/*
Expected: 正确通过语义分析，无错误
测试点: 子类赋给父类变量的类型兼容性
*/
