int a[600];

int main() {
  int x = 0;
  int i = 0;
  while (i < 600) {
    if (i == 0) {
      int x = 7;
      a[i] = x;
    }
    x = i;
    int j = 0;
    while (j < 2) {
      a[i] = i + j;
      j = j + 1;
    }
    i = i + 1;
  }
  putint(x);
  putch(10);
  putint(a[599]);
  putch(10);
  return 0;
}
