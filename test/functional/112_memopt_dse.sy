// Memory Optimization: dead store elimination
// Storing to arr[i] then immediately overwriting makes first store dead

int arr[10];
int main() {
    int i;
    i = 0;
    arr[0] = 1;    // dead: overwritten below
    arr[0] = 2;
    arr[1] = 3;    // dead
    arr[1] = 4;    // dead
    arr[1] = 5;
    return arr[0] + arr[1];  // 2 + 5 = 7
}
