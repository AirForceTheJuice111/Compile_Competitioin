// Keep more than four loop-carried SSA values live across a real call while
// pointer calculations and parallel PHI copies are also active.
int regalloc_step(int x) {
  if (x <= 0) {
    return 1;
  }
  return regalloc_step(x - 1) + 1;
}

int regalloc_mix(int values[], int count) {
  int i = 0;
  int a = 1;
  int b = 2;
  int c = 3;
  int d = 4;
  int e = 5;
  int f = 6;
  int g = 7;
  int h = 8;
  while (i < count) {
    int k = regalloc_step(values[i] % 4);
    a = a + h + k;
    b = b + a - k;
    c = c + b + k;
    d = d + c - k;
    e = e + d + k;
    f = f + e - k;
    g = g + f + k;
    h = h + g - k;
    if ((i % 2) == 0) {
      e = e + values[i];
    }
    else {
      f = f - values[i];
    }
    values[i] = a - b + c - d + e - f + g - h;
    i = i + 1;
  }
  return a + b + c + d + e + f + g + h + values[0] +
         values[count - 1];
}

int main() {
  int values[6] = {3, 1, 4, 1, 5, 9};
  putint(regalloc_mix(values, 6));
  putch(10);
  return 0;
}
