void fill(int a[], int b[]) {
  int i = 0;
  while (i < 20000) {
    a[i] = a[i];
    int j = 0;
    while (j < 20) {
      a[i] = b[i] + 1;
      j = j + 1;
    }
    i = i + 2;
  }
}

int main() {
  int data[20000];
  int i = 0;
  while (i < 20000) {
    data[i] = 1;
    i = i + 1;
  }
  fill(data, data);
  int sum = 0;
  i = 0;
  while (i < 20000) {
    sum = sum + data[i];
    i = i + 1;
  }
  putint(sum);
  putch(10);
  return 0;
}
