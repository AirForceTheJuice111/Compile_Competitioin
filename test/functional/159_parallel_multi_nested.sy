int main() {
  int n = getint();
  int first = 0;
  int second = 0;
  int i;
  int j;
  i = 0;
  while (i < n) {
    j = 0;
    while (j < n) {
      first = first + (i + j);
      second = second + (i * 2 - j);
      j = j + 1;
    }
    i = i + 1;
  }
  putint(first);
  putch(32);
  putint(second);
  putch(32);
  putint(i);
  putch(10);
  return 0;
}
