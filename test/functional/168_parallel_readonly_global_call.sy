int table[20000];
int mapped[20000];

int read_table(int index) {
  return table[index] * 3 + 7;
}

int read_table_twice(int index) {
  return read_table(index);
}

int main() {
  int i;
  i = 0;
  while (i < 20000) {
    table[i] = i % 97;
    i = i + 1;
  }
  i = 0;
  while (i < 20000) {
    mapped[i] = read_table_twice(i);
    i = i + 1;
  }
  int sum = 0;
  i = 0;
  while (i < 20000) {
    sum = sum + mapped[i];
    i = i + 1;
  }
  putint(sum);
  putch(10);
  return 0;
}
