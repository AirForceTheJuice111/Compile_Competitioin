int renamed_and(int lhs, int rhs) {
    int left_bit, right_bit;
    int count = 32, answer = 0, place = 1;
    while (count) {
        left_bit = lhs % 2;
        right_bit = rhs % 2;
        lhs = lhs / 2;
        rhs = rhs / 2;
        if (left_bit == 1 && right_bit == 1) {
            answer = answer + place;
        }
        place = place * 2;
        count = count - 1;
    }
    return answer;
}

int renamed_xor(int lhs, int rhs) {
    int left_bit, right_bit;
    int count = 32, answer = 0, place = 1;
    while (count) {
        left_bit = lhs % 2;
        right_bit = rhs % 2;
        lhs = lhs / 2;
        rhs = rhs / 2;
        if (left_bit != right_bit) {
            answer = answer + place;
        }
        place = place * 2;
        count = count - 1;
    }
    return answer;
}

int renamed_or(int lhs, int rhs) {
    int left_bit, right_bit;
    int count = 32, answer = 0, place = 1;
    while (count) {
        left_bit = lhs % 2;
        right_bit = rhs % 2;
        lhs = lhs / 2;
        rhs = rhs / 2;
        if (left_bit == 1 || right_bit == 1) {
            answer = answer + place;
        }
        place = place * 2;
        count = count - 1;
    }
    return answer;
}

int main() {
    putint(renamed_and(13, 11));
    putch(32);
    putint(renamed_xor(13, 11));
    putch(32);
    putint(renamed_or(13, 11));
    putch(10);
    putint(renamed_and(-1, 1));
    putch(32);
    putint(renamed_xor(-1, 1));
    putch(32);
    putint(renamed_or(-1, 1));
    putch(10);
    putint(renamed_and(6, -3));
    putch(32);
    putint(renamed_xor(6, -3));
    putch(32);
    putint(renamed_or(6, -3));
    putch(10);
    putint(renamed_and(-3, -5));
    putch(32);
    putint(renamed_xor(-3, -5));
    putch(32);
    putint(renamed_or(-3, -5));
    putch(10);
    return 0;
}
