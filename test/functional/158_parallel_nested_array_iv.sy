int a[64][64];

int main() {
  int n = getint();
  int i;
  int j;
  i = 0;
  while (i < n) {
    j = 0;
    int scratch = 0;
    while (j < n) {
      a[i][j] = i + j;
      scratch = scratch + a[i][j];
      j = j + 1;
    }
    i = i + 1;
  }

  int answer = 0;
  i = 0;
  while (i < n) {
    j = 0;
    while (j < n) {
      answer = answer + a[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  putint(answer);
  putch(10);
  return 0;
}
