int values[40000];

int main() {
  int i = 0;
  while (i < 20000) {
    int j = 0;
    while (j < 4) {
      values[i * 2 + 1] = values[i * 2 + 1] + j;
      j = j + 1;
    }
    i = i + 1;
  }
  putint(values[1]);
  putch(32);
  putint(values[3]);
  putch(32);
  putint(values[39999]);
  putch(10);
  return 0;
}
