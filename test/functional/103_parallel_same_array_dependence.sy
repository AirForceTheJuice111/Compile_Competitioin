int main() {
  int a[600];
  int i = 0;
  while (i < 600) {
    a[i] = i;
    i = i + 1;
  }

  i = 0;
  while (i < 599) {
    int j = 0;
    while (j < 20) {
      a[i] = a[i + 1] + j;
      j = j + 1;
    }
    i = i + 1;
  }

  int sum = 0;
  i = 0;
  while (i < 600) {
    sum = sum + a[i];
    i = i + 1;
  }
  putint(sum);
  putch(10);
  return 0;
}
