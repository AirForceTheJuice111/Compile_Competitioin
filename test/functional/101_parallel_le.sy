int main() {
  int a[600];
  int i = 0;
  while (i <= 599) {
    int j = 0;
    a[i] = 0;
    while (j < 4) {
      a[i] = a[i] + i + j;
      j = j + 1;
    }
    i = i + 1;
  }

  int sum = 0;
  i = 0;
  while (i < 600) {
    sum = sum + a[i];
    i = i + 1;
  }
  putint(sum);
  putch(10);
  return 0;
}
