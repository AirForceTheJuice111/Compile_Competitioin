// Variadic floats are promoted to doubles.  Twelve live values exercise all
// eight FP argument registers plus the variadic stack argument area.
int main() {
  float f0 = getfloat();
  float f1 = getfloat();
  float f2 = getfloat();
  float f3 = getfloat();
  float f4 = getfloat();
  float f5 = getfloat();
  float f6 = getfloat();
  float f7 = getfloat();
  float f8 = getfloat();
  float f9 = getfloat();
  float f10 = getfloat();
  float f11 = getfloat();
  putf("%f %f %f %f %f %f %f %f %f %f %f %f\n",
       f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11);
  return 0;
}
