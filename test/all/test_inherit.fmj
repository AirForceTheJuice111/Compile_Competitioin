public int main() {
    class Animal a;
    class Dog d;
    int x;

    a = new Animal();
    d = new Dog();

    x = a.speak();
    putint(x);
    putch(10);

    x = d.speak();
    putint(x);
    putch(10);

    a = d;
    x = a.speak();
    putint(x);
    putch(10);

    return 0;
}

public class Animal {
    int sound = 1;
    public int speak() {
        return this.sound;
    }
}

public class Dog extends Animal {
    int sound = 2;
    public int speak() {
        return this.sound;
    }
}
