public int main() {
  int i;
  i = 1;
  
  while (i<=100) {
    if (!(new p().fizz(i) + new p().buzz(i)))
      putint(i); 
    putch(32);
    i = i + 1;
  } 
  putch(10);
}

public class p {
  public int fizz(int n) {
   if ( (n/3)*3 == n ) {
     putch(102); putch(105); putch(122); putch(122);    
     return 1;
   }
   return 0;
  }
  public int buzz(int n) {
   if ( (n/5)*5 == n ) {
     putch(98); putch(117); putch(122); putch(122);
     return 1;
   }
   return 0;
  }
}
