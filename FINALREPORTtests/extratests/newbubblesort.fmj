public class b1 {
  int temp;
  public int bubbleSort(int[] array, int size) {
    int i;

    i = 0;
    if (size <= 1) {
      return 0;
    }

    while (i < size - 1) {
      if (array[i] > array[i + 1]) {
        this.temp = array[i];
        array[i] = array[i + 1];
        array[i + 1] = this.temp;
      }
      i = i + 1;
    }

    return this.bubbleSort(array, size - 1);
  }
}

