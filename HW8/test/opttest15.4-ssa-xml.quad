<!-- Test 15: Multi-function program (tests optProg iterating over all functions)
     func1: constant function (RETURN Const:7), all assignments removed
     func2: unknown function (getint then return), kept as-is -->
<Program kind="PROGRAM" last_label_num="104" last_temp_num="102">
    <funcdecl kind="FUNCDECL" name="func1" last_label_num="102" last_temp_num="101">
        <block kind="BLOCK" entry="102">
            <label kind="LABEL" name="102"/>
            <move kind="MOVE" dst="10000" temp_type="int">
                <src kind="CONST" value="7"/>
                <def>
                    <temp id="10000"/>
                </def>
            </move>
            <return kind="RETURN">
                <value kind="TEMP" id="10000" type="int"/>
                <use>
                    <temp id="10000"/>
                </use>
            </return>
        </block>
    </funcdecl>
    <funcdecl kind="FUNCDECL" name="func2" last_label_num="104" last_temp_num="102">
        <block kind="BLOCK" entry="104">
            <label kind="LABEL" name="104"/>
            <moveextcall kind="MOVE_EXTCALL" dst="10100" temp_type="int">
                <extcall kind="EXTCALL" name="getint"/>
                <def>
                    <temp id="10100"/>
                </def>
            </moveextcall>
            <return kind="RETURN">
                <value kind="TEMP" id="10100" type="int"/>
                <use>
                    <temp id="10100"/>
                </use>
            </return>
        </block>
    </funcdecl>
</Program>
