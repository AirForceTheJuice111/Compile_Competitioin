<!-- Test 13: Loop with MANY_VALUES phi (back-edge, non-constant counter)
     t10000=getint() (MANY), loop decrements: t10001 phi, t10002=t10001-1
     All blocks remain reachable; phi stays MANY; loop body kept intact -->
<Program kind="PROGRAM" last_label_num="105" last_temp_num="102">
    <funcdecl kind="FUNCDECL" name="__$main__^main" last_label_num="105" last_temp_num="102">
        <block kind="BLOCK" entry="105">
            <exits>
                <exit label="102"/>
            </exits>
            <label kind="LABEL" name="105"/>
            <moveextcall kind="MOVE_EXTCALL" dst="10000" temp_type="int">
                <extcall kind="EXTCALL" name="getint"/>
                <def>
                    <temp id="10000"/>
                </def>
            </moveextcall>
            <jump kind="JUMP" target="102"/>
        </block>
        <block kind="BLOCK" entry="102">
            <exits>
                <exit label="103"/>
                <exit label="104"/>
            </exits>
            <label kind="LABEL" name="102"/>
            <phi kind="PHI" dst="10001" temp_type="int">
                <args>
                    <arg temp="t10000" label="L105"/>
                    <arg temp="t10002" label="L103"/>
                </args>
                <def>
                    <temp id="10001"/>
                </def>
                <use>
                    <temp id="10000"/>
                    <temp id="10002"/>
                </use>
            </phi>
            <cjump kind="CJUMP" relop=">" true="103" false="104">
                <left kind="TEMP" id="10001" type="int"/>
                <right kind="CONST" value="0"/>
                <use>
                    <temp id="10001"/>
                </use>
            </cjump>
        </block>
        <block kind="BLOCK" entry="103">
            <exits>
                <exit label="102"/>
            </exits>
            <label kind="LABEL" name="103"/>
            <movebinop kind="MOVE_BINOP" dst="10002" temp_type="int" op="-">
                <left kind="TEMP" id="10001" type="int"/>
                <right kind="CONST" value="1"/>
                <def>
                    <temp id="10002"/>
                </def>
                <use>
                    <temp id="10001"/>
                </use>
            </movebinop>
            <jump kind="JUMP" target="102"/>
        </block>
        <block kind="BLOCK" entry="104">
            <label kind="LABEL" name="104"/>
            <return kind="RETURN">
                <value kind="TEMP" id="10001" type="int"/>
