<!-- Test 16: undefined temp (NO_VALUE) used in reachable CJUMP.
     t10001 is never assigned; used in CJUMP > t10001 Const:0? L103 : L104
     Expected behavior per README: warning printed, t10001 promoted to MANY_VALUES,
     both branches L103 and L104 marked executable, CJUMP kept in output. -->
<Program kind="PROGRAM" last_label_num="104" last_temp_num="101">
    <funcdecl kind="FUNCDECL" name="__$main__^main" last_label_num="104" last_temp_num="101">
        <block kind="BLOCK" entry="104">
            <exits>
                <exit label="102"/>
                <exit label="103"/>
            </exits>
            <label kind="LABEL" name="104"/>
            <cjump kind="CJUMP" relop=">" true="102" false="103">
                <left kind="TEMP" id="10001" type="int"/>
                <right kind="CONST" value="0"/>
                <use>
                    <temp id="10001"/>
                </use>
            </cjump>
        </block>
        <block kind="BLOCK" entry="102">
            <label kind="LABEL" name="102"/>
            <return kind="RETURN">
                <value kind="CONST" value="1"/>
            </return>
        </block>
        <block kind="BLOCK" entry="103">
            <label kind="LABEL" name="103"/>
            <return kind="RETURN">
                <value kind="CONST" value="0"/>
            </return>
        </block>
    </funcdecl>
</Program>
